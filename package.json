{
  "name": "footprint-storydeck",
  "version": "0.4.0",
  "description": "One source, many lenses — render structured content as a Read article, a Scroll (scrollytelling) story, or a Watch deck.",
  "type": "module",
  "license": "MIT",
  "author": "Sanjay Krishna Anbalagan",
  "repository": { "type": "git", "url": "git+https://github.com/footprintjs/storydeck.git" },
  "homepage": "https://github.com/footprintjs/storydeck#readme",
  "bugs": "https://github.com/footprintjs/storydeck/issues",
  "keywords": ["slides", "deck", "presentation", "scrollytelling", "react", "narration", "captions", "voice", "video", "talk", "focus", "footprintjs"],
  "engines": { "node": ">=22" },
  "sideEffects": ["*.css"],
  "types": "./index.d.ts",
  "exports": {
    ".": { "types": "./index.d.ts", "default": "./index.js" },
    "./focus": { "types": "./focus.d.ts", "default": "./focus.js" },
    "./focus-html": { "types": "./focusHtml.d.ts", "default": "./focusHtml.js" },
    "./focus.css": "./focus.css",
    "./narration": { "types": "./narration.d.ts", "default": "./narration.js" },
    "./narration-html": { "types": "./narrationHtml.d.ts", "default": "./narrationHtml.js" },
    "./narration.css": "./narration.css",
    "./voice": { "types": "./voice.d.ts", "default": "./voice.js" },
    "./video": { "types": "./video.d.ts", "default": "./video.js" },
    "./storydeck.css": "./storydeck.css",
    "./deck-stage.js": "./site/public/deck-stage.js"
  },
  "files": ["/*.js", "/*.jsx", "/*.d.ts", "/*.css", "content", "site/public/deck-stage.js", "plugin", "README.md", "CHANGELOG.md", "LICENSE", "!*.test.js", "!*.test.jsx", "!vitest.config.js", "!vitest.setup.js"],
  "scripts": {
    "test": "vitest run",
    "test:cov": "vitest run --coverage"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "dependencies": {
    "footprint-narration": "^0.1.0",
    "markdown-it": "^14.1.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^5.0.4",
    "@vitest/coverage-v8": "^4.1.9",
    "jsdom": "^29.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": "^4.1.9"
  }
}
